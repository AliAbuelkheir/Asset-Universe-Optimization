{
  "name": "portfolio-simulator-web",
  "private": true,
  "version": "0.1.0",
  "description": "React and FastAPI historical portfolio simulator for PPO risk buckets.",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n ml,client -c cyan,magenta \"npm:dev:ml\" \"npm:dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:ml": "..\\ppo-risk-model\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir ml-service --host 127.0.0.1 --port 8000 --reload",
    "build": "npm --prefix client run build",
    "test": "npm --prefix client test && ..\\ppo-risk-model\\.venv\\Scripts\\python.exe -m pytest ml-service/tests"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
