{
  "name": "@portfolio-simulator/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "node ../scripts/run-with-timeout.mjs --timeout-ms 60000 -- node.exe ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit --incremental false && node ../scripts/run-with-timeout.mjs --timeout-ms 60000 -- node.exe ../node_modules/vite/bin/vite.js build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node ../scripts/run-with-timeout.mjs --timeout-ms 60000 -- node.exe ../node_modules/vitest/vitest.mjs run --pool=threads --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "lucide-react": "^0.503.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.1",
    "vite": "^6.3.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
